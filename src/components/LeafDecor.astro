---
interface Props {
  class?: string;
  size?: number;
  rotate?: number;
  opacity?: number;
}
const { class: className = '', size = 80, rotate = 0, opacity = 0.12 } = Astro.props;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 80 80"
  fill="none"
  class={className}
  style={`transform: rotate(${rotate}deg); opacity: ${opacity};`}
>
  <!-- Main leaf -->
  <path
    d="M40 70 C20 60, 5 45, 8 25 C12 8, 30 4, 40 10 C50 4, 68 8, 72 25 C75 45, 60 60, 40 70Z"
    fill="#16a34a"
  />
  <!-- Midrib -->
  <line x1="40" y1="10" x2="40" y2="68" stroke="#fff" stroke-width="1.5" stroke-linecap="round"/>
  <!-- Veins left -->
  <line x1="40" y1="28" x2="22" y2="22" stroke="#fff" stroke-width="0.8" stroke-linecap="round" opacity="0.7"/>
  <line x1="40" y1="38" x2="18" y2="34" stroke="#fff" stroke-width="0.8" stroke-linecap="round" opacity="0.7"/>
  <line x1="40" y1="48" x2="20" y2="46" stroke="#fff" stroke-width="0.8" stroke-linecap="round" opacity="0.7"/>
  <!-- Veins right -->
  <line x1="40" y1="28" x2="58" y2="22" stroke="#fff" stroke-width="0.8" stroke-linecap="round" opacity="0.7"/>
  <line x1="40" y1="38" x2="62" y2="34" stroke="#fff" stroke-width="0.8" stroke-linecap="round" opacity="0.7"/>
  <line x1="40" y1="48" x2="60" y2="46" stroke="#fff" stroke-width="0.8" stroke-linecap="round" opacity="0.7"/>
</svg>
