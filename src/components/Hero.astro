---
import LeafDecor from './LeafDecor.astro';
---

<style>
  @keyframes float1 {
    0%, 100% { transform: rotate(-4deg) translateY(0px); }
    50%       { transform: rotate(-4deg) translateY(-10px); }
  }
  @keyframes float2 {
    0%, 100% { transform: rotate(5deg) translateY(0px); }
    50%       { transform: rotate(5deg) translateY(-14px); }
  }
  .photo1 { animation: float1 5s ease-in-out infinite; }
  .photo2 { animation: float2 6.5s ease-in-out infinite 0.8s; }
</style>

<section id="hero" class="relative min-h-screen flex items-center px-6 md:px-12 lg:px-24 py-20 overflow-hidden bg-white">

  <!-- Botanical background decorations -->
  <LeafDecor class="absolute -top-8 -right-8 pointer-events-none" size={200} rotate={-20} opacity={0.07} />
  <LeafDecor class="absolute bottom-10 -left-12 pointer-events-none" size={240} rotate={40} opacity={0.06} />
  <LeafDecor class="absolute top-1/3 right-8 pointer-events-none" size={120} rotate={15} opacity={0.05} />

  <!-- Subtle grid pattern (code editor feel) -->
  <div class="absolute inset-0 pointer-events-none" style="background-image: radial-gradient(circle, #d1d5db 1px, transparent 1px); background-size: 28px 28px; opacity: 0.3;"></div>

  <div class="relative max-w-6xl mx-auto w-full grid md:grid-cols-2 gap-12 items-center">
    <!-- Text -->
    <div class="order-2 md:order-1">
      <!-- Code comment label -->
      <p class="font-mono text-emerald-600 text-sm mb-4">
        <span style="color: var(--color-forest-400)">/**</span><br />
        &nbsp;* <span class="text-emerald-600 font-medium">@engineer</span> Kai Kanesaka<br />
        &nbsp;* <span class="text-emerald-600 font-medium">@team</span> 8 hackathons, 3 awards<br />
        <span style="color: var(--color-forest-400)">&nbsp;*/</span>
      </p>

      <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold leading-tight mb-6" style="color: var(--color-forest-950)">
        チームのために<br />
        <span class="text-emerald-600">動くエンジニア。</span>
      </h1>

      <p class="text-lg leading-relaxed mb-8" style="color: var(--color-forest-400)">
        金坂 櫂 ／ Kai Kanesaka<br />
        明治大学 情報コミュニケーション学部 3年
      </p>

    </div>

    <!-- Photos: 2枚を斜めにずらして重ねる -->
    <div class="order-1 md:order-2 flex justify-center md:justify-end">
      <div class="relative w-80 h-[420px] md:w-96 md:h-[480px]">

        <!-- 後ろの写真（岩場・座禅）: 右下 -->
        <div class="photo2 absolute bottom-0 right-0 w-48 h-60 md:w-56 md:h-72 rounded-2xl overflow-hidden shadow-xl"
             style="transform: rotate(5deg);">
          <img src="/hero2.jpg" alt="岩場で座禅" class="w-full h-full object-cover" />
        </div>

        <!-- 前の写真（海辺・空）: 左上 -->
        <div class="photo1 absolute top-0 left-0 w-48 h-60 md:w-56 md:h-72 rounded-2xl overflow-hidden shadow-2xl"
             style="transform: rotate(-4deg);">
          <img src="/hero1.jpg" alt="海辺で空を見上げる" class="w-full h-full object-cover object-top" />
        </div>

      </div>
    </div>
  </div>

  <!-- Scroll down button -->
  <div class="absolute bottom-10 left-1/2 -translate-x-1/2">
    <a href="#about" class="flex flex-col items-center gap-2 group" style="color: var(--color-forest-400)">
      <span class="text-sm font-medium tracking-widest" style="color: var(--color-forest-600)">SCROLL</span>
      <div class="w-12 h-12 rounded-full border-2 flex items-center justify-center group-hover:border-emerald-500 group-hover:text-emerald-500 transition-colors" style="border-color: #b8cfc3">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 5v14M5 12l7 7 7-7"/>
        </svg>
      </div>
    </a>
  </div>
</section>
